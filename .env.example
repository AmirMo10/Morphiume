# Development/test values only. Generate secrets; never copy these examples into live.
DEPLOYMENT_ENV=test
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://morphiume:CHANGE_ME@127.0.0.1:5433/morphiume_test
AUTH_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_AUTH_SECRET=GENERATE_ANOTHER_32_RANDOM_CHARACTERS
PAYMENT_PROVIDER=mock
SMS_PROVIDER=mock
MOCK_CONTROL_SECRET=GENERATE_A_PRIVATE_TEST_CONTROL_SECRET
# Anonymous synthetic test/staging capture is opt-in; owner live policy is still required.
ANONYMOUS_ANALYTICS_ENABLED=false
MEDIA_ROOT=./.local/media
BOOTSTRAP_ADMIN_EMAIL=owner@morphiume.test
BOOTSTRAP_ADMIN_PASSWORD=GENERATE_A_RANDOM_TEST_OWNER_PASSWORD
# Live-only real-provider inputs; no merchant or business data is invented.
ZARINPAL_MERCHANT_ID=
SMS_API_KEY=
SMS_SERVICE_TEMPLATE=
PUBLIC_SITE_URL=
