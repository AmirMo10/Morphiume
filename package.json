{
  "name": "morphiume",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=24.19.0 <25" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "setup:dev": "node scripts/bootstrap-dev.mjs",
    "build": "next build && node scripts/build-runtime.mjs && node deploy/staging/trace-runtime.mjs && node scripts/prepare-standalone.mjs",
    "build:runtime": "node scripts/build-runtime.mjs",
    "start": "node scripts/start.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "test:load": "node scripts/run-load.mjs",
    "db:migrate": "node --conditions=react-server --import tsx db/migrate.ts",
    "db:seed": "node --conditions=react-server --import tsx db/seed.ts",
    "worker": "node --conditions=react-server --import tsx src/server/worker.ts",
    "skills:validate": "python scripts/validate-skills.py"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.4",
    "dotenv": "18.0.7",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
