{
  "$schemaNote": "Original Morphiume design tokens; CSS px and milliseconds unless stated",
  "version": "2026-10-12",
  "color": {
    "canvas": "#F6F2EB",
    "surface": "#FFFDFA",
    "ink": "#20211F",
    "muted": "#62645E",
    "brand": "#5C2333",
    "onBrand": "#F6F2EB",
    "brandHover": "#471A28",
    "borderSubtle": "#D8D1C7",
    "borderControl": "#85867E",
    "success": "#256348",
    "danger": "#A12F3D",
    "warning": "#765312"
  },
  "spacing": [
    4,
    8,
    12,
    16,
    24,
    32,
    48,
    64,
    96
  ],
  "font": {
    "family": "Vazirmatn",
    "body": {
      "size": 16,
      "lineHeight": 1.8,
      "weight": 400
    },
    "support": {
      "size": 14,
      "lineHeight": 1.7
    },
    "labelWeight": 500,
    "actionWeight": 600
  },
  "layout": {
    "contentMax": 1280,
    "readingMax": 640,
    "gutters": {
      "base": 16,
      "640": 24,
      "1024": 40
    }
  },
  "control": {
    "minHeight": 48,
    "minTarget": 44,
    "radius": 2,
    "focusWidth": 3,
    "focusOffset": 3
  },
  "motion": {
    "feedback": 140,
    "drawer": 220,
    "easing": "cubic-bezier(0.2, 0, 0, 1)",
    "reduced": "no transforms"
  },
  "contrastPairs": [
    {
      "foreground": "ink",
      "background": "canvas",
      "min": 4.5
    },
    {
      "foreground": "muted",
      "background": "canvas",
      "min": 4.5
    },
    {
      "foreground": "muted",
      "background": "surface",
      "min": 4.5
    },
    {
      "foreground": "onBrand",
      "background": "brand",
      "min": 4.5
    },
    {
      "foreground": "onBrand",
      "background": "brandHover",
      "min": 4.5
    },
    {
      "foreground": "brand",
      "background": "canvas",
      "min": 4.5
    },
    {
      "foreground": "success",
      "background": "canvas",
      "min": 4.5
    },
    {
      "foreground": "danger",
      "background": "canvas",
      "min": 4.5
    },
    {
      "foreground": "warning",
      "background": "canvas",
      "min": 4.5
    },
    {
      "foreground": "borderControl",
      "background": "canvas",
      "min": 3
    },
    {
      "foreground": "borderControl",
      "background": "surface",
      "min": 3
    }
  ]
}
