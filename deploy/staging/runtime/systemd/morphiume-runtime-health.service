[Unit]
Description=Morphiume fresh staging runtime local health evaluation
After=docker.service
Requires=docker.service
ConditionPathExists=/etc/morphiume-staging-runtime/schedule-approved.json

[Service]
Type=oneshot
WorkingDirectory=/etc/morphiume-staging-runtime
EnvironmentFile=/etc/morphiume-staging-runtime/deploy.env
ExecStart=/usr/bin/python3 ${MORPHIUME_OPS_ROOT}/runtime/scheduled.py health --apply
TimeoutStartSec=50s
User=root
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
MemoryMax=256M
CPUQuota=25%
StandardOutput=journal
StandardError=journal
